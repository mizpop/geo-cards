{
  "name": "geochecker",
  "productName": "GeoChecker",
  "version": "1.0.0",
  "description": "GeoChecker（GeoGuessr 学習アプリ）のデスクトップ版。公開中のサイトを読み込むので、サイトの更新は自動で反映されます",
  "main": "main.js",
  "author": "mizpop",
  "scripts": { "start": "electron .", "build": "electron-builder --win portable" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "net.pages.geo-cards.geochecker",
    "productName": "GeoChecker",
    "files": ["main.js", "icon.png", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false, "icon": "icon.png" },
    "portable": { "artifactName": "GeoChecker.exe" },
    "directories": { "output": "dist" }
  }
}
